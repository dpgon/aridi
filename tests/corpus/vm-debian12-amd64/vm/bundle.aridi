--c03e21af83fbdf651626ab53afbfd711 begin firewall.nft kind=cmd tool=nft limit=4194304
table ip nat {
	chain LIMADNS {
		ip daddr 192.168.5.3 udp dport 53 counter packets 6 bytes 402 dnat to 192.168.5.2:54618
		ip daddr 192.168.5.3 tcp dport 53 counter packets 0 bytes 0 dnat to 192.168.5.2:63637
	}

	chain PREROUTING {
		type nat hook prerouting priority dstnat; policy accept;
		counter packets 2 bytes 88 jump LIMADNS
	}

	chain OUTPUT {
		type nat hook output priority -100; policy accept;
		counter packets 29 bytes 1982 jump LIMADNS
	}
}
table inet aridi_corpus {
	chain input {
		type filter hook input priority filter + 10; policy accept;
		ip saddr 192.0.2.10 tcp dport 22 accept
		ip6 saddr 2001:db8::10 tcp dport 22 accept
	}

	chain output {
		type filter hook output priority filter + 10; policy accept;
		ip daddr 198.51.100.5 tcp dport 443 accept
	}

	chain forward {
		type filter hook forward priority filter + 10; policy drop;
		ip saddr 10.0.0.0/8 accept
	}
}

--c03e21af83fbdf651626ab53afbfd711 end firewall.nft status=ok rc=0
